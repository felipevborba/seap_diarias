# /etc/systemd/system/pjes.service
# PJES SEAP - mesmo servidor do CarteiraPenal (carteira.service, 4443) e das Diárias (diarias.service, 4444).
# Kestrel direto na 4445 (o gateway publica pjes.seap.pe.gov.br -> servidor:4445).
# Segredos (connection string, JWT) ficam em /etc/pjes/pjes.env (chmod 600, dono root),
# fora do diretório publicado e fora do git.
[Unit]
Description=PJES SEAP (ASP.NET Core) - porta 4445
After=network.target

[Service]
WorkingDirectory=/var/www/pjes
ExecStart=/var/www/pjes/PjesSeap.Api
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=pjes
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
EnvironmentFile=/etc/pjes/pjes.env

[Install]
WantedBy=multi-user.target
