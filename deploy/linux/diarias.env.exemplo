# Copiar para /etc/diarias/diarias.env no servidor (chmod 600) e preencher.
# Mesmo banco do CarteiraPenal ("carteira" em 10.238.118.253). Recomendado: um usuário de banco
# próprio para as Diárias, com permissão de leitura nas tabelas public.* compartilhadas,
# leitura/escrita em public.usuario e dono dos schemas comum e diarias.
ConnectionStrings__DefaultConnection=Host=10.238.118.253;Port=5432;Database=carteira;Username=TROCAR;Password=TROCAR
# Segredo do JWT: no mínimo 32 caracteres aleatórios (ex.: openssl rand -base64 48). NÃO reutilizar o da Carteira.
JwtSettings__Secret=TROCAR
# IP do gateway que repassa a 4444 (para registrar o IP real do usuário e limitar tentativas de login).
# Proxy__IpsConfiaveis__0=10.238.118.1
