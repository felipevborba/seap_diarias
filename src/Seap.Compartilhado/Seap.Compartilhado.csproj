<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Núcleo compartilhado entre os sistemas da SEAP/SERES que usam o mesmo PostgreSQL
    (CarteiraPenal, Diárias, futuramente PJES): mapeamento das tabelas comuns,
    autenticação (cifra Delphi + JWT), auditoria transversal e envelopes de resposta.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sql\*.sql" />
  </ItemGroup>

</Project>
